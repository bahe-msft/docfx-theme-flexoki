{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "samples/Flexoki.Sample",
          "files": ["Flexoki.Sample.csproj"]
        }
      ],
      "dest": "obj/api"
    }
  ],
  "build": {
    "content": [
      { "files": ["index.md", "toc.yml", "articles/**/*.{md,yml}"] },
      { "src": "obj/api", "dest": "api", "files": ["**/*.yml"] }
    ],
    "resource": [
      { "files": ["images/**"] }
    ],
    "globalMetadata": {
      "_appTitle": "Flexoki for DocFX",
      "_appName": "Flexoki",
      "_appLogoPath": "images/logo.svg",
      "_appFaviconPath": "images/favicon.svg",
      "_appFooter": "Flexoki for DocFX · <a href=\"https://stephango.com/flexoki\">Flexoki palette</a> · <a href=\"https://dotnet.github.io/docfx/\">DocFX</a>",
      "_enableSearch": true,
      "_lang": "en"
    },
    "template": ["default", "modern", "template"],
    "output": "_site"
  }
}
